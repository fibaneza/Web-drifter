{
  "name": "web-drifter",
  "version": "0.1.0",
  "description": "Detect visual, content, link and CSS drift between a legacy website and its modern rewrite.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "drifter": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .drifter-tmp",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-reporter=spec \"test/integration/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm run test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "colord": "^2.9.3",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "fast-xml-parser": "^4.5.0",
    "p-limit": "^6.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.5",
    "undici": "^6.20.1",
    "yazl": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.8.0",
    "@types/pngjs": "^6.0.5",
    "@types/yazl": "^3.3.1",
    "c8": "^10.1.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
